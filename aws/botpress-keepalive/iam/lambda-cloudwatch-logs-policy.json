{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateLambdaLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:*"
    },
    {
      "Sid": "WriteOnlyThisLambdaLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/botpress-keepalive:*"
    }
  ]
}
