APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
FILESYSTEM_IMAGE_DISK=s3
FILESYSTEM_IMAGE_FALLBACK_DISK=public
QUEUE_CONNECTION=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_CLOUDWATCH_REGION=${AWS_DEFAULT_REGION}
AWS_CLOUDWATCH_VERSION=latest
AWS_CLOUDWATCH_INSTANCE_ID=
AWS_CLOUDWATCH_EC2_NAMESPACE=AWS/EC2
AWS_CLOUDWATCH_CPU_METRIC=CPUUtilization
AWS_CLOUDWATCH_CWAGENT_NAMESPACE=CWAgent
AWS_CLOUDWATCH_MEMORY_METRIC=mem_used_percent
AWS_CLOUDWATCH_MEMORY_DIMENSIONS=
AWS_CLOUDWATCH_PERIOD=300
AWS_CLOUDWATCH_LOOKBACK_MINUTES=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

KNOWLEDGE_SYNC_BASE_URL=${APP_URL}
KNOWLEDGE_SYNC_MAX_DEPTH=2
KNOWLEDGE_SYNC_MAX_PAGES=80
KNOWLEDGE_SYNC_MANUAL_URLS=

KNOWLEDGE_SYNC_FETCH_TIMEOUT=15
KNOWLEDGE_SYNC_FETCH_CONNECT_TIMEOUT=8
KNOWLEDGE_SYNC_FETCH_MAX_REDIRECTS=3
KNOWLEDGE_SYNC_FETCH_MAX_BYTES=5000000
KNOWLEDGE_SYNC_MAX_TEXT_BYTES=200000

BOTPRESS_API_BASE_URL=https://api.botpress.cloud
BOTPRESS_PAT=
BOTPRESS_BOT_ID=
BOTPRESS_KNOWLEDGE_BASE_ID=
BOTPRESS_FILE_KEY_PREFIX=knowledge-sync
BOTPRESS_WEBHOOK_SECRET=
BOTPRESS_WEBHOOK_URL=${APP_URL}/api/botpress/webhook
